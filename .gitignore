# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example hanya berisi placeholder dan memang harus ikut ke Git
!.env.example

# credential Google (JANGAN pernah masuk Git)
*.json.key
service-account*.json
google-credentials*.json


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# snapshot migrasi historis (MEMUAT DATA PRIBADI — jangan pernah masuk Git)
# Ditulis oleh `npm run migration:snapshot -- --write-raw`.
.migration-snapshots/

# arsip backup database (dump logis; MEMUAT DATA — jangan pernah masuk Git)
# Ditulis oleh rehearsal backup/restore P0E-2A (scripts/p0e2a-rehearsal.mjs).
.migration-backups/
