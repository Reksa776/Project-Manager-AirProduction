# Air Production DB — contoh environment variable (TEMPLATE).
#
# Cara pakai:
#   1. Salin file ini menjadi `.env.local`
#   2. Isi nilainya dengan credential asli di `.env.local` saja
#
# JANGAN pernah mengisi nilai asli pada file ini (.env.example),
# karena file ini ikut masuk ke Git.

# ID Spreadsheet "Air Production DB".
# Ambil dari URL spreadsheet: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=

# Email Service Account.
# Format: <nama>@<project-id>.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari JSON key Service Account.
# Tulis dalam satu baris, dibungkus tanda kutip ganda, dengan \n sebagai pemisah baris.
GOOGLE_PRIVATE_KEY=
