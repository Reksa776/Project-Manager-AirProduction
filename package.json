{
  "name": "air-production-db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "node scripts/db-seed.mjs",
    "db:transfer": "node scripts/migrate-mysql-to-supabase.mjs",
    "migration:snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/migration-ts-register.mjs src/migration-cli/cli.ts snapshot",
    "migration:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/migration-ts-register.mjs src/migration-cli/cli.ts preflight",
    "migration:rehearsal": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/migration-ts-register.mjs scripts/p0e2a-rehearsal.mjs",
    "migration:backup:local": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/migration-ts-register.mjs scripts/p0e2a1-local-backup.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^183.0.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
