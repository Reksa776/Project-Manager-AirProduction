# Supabase PostgreSQL connection (server-side only; never expose to NEXT_PUBLIC_*).
# Copy this file to .env and paste the connection string from Supabase > Connect.
# Prefer the Session Pooler or Direct connection string. URL-encode special chars
# in the database password. Keep sslmode=require when supplied by Supabase.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require"

# Existing MySQL database, used only as the source during the one-time transfer.
# Leave empty/remove after the data has been copied and verified.
MYSQL_SOURCE_URL="mysql://USER:YOUR_URL_ENCODED_PASSWORD@HOST:3306/airprod_dev"
